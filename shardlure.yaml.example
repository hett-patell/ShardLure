data_dir: /var/lib/shardlure

admin_ips:
  - 100.x.x.x   # your Tailscale IP or admin workstation

ssh:
  admin_port: 2222
  honeypot_port: 22

dashboard:
  port: 8080
  # Change these to your VPS/operator location for the globe origin.
  home_lat: 19.0760
  home_lon: 72.8777
  home_city: Mumbai
  home_country: India
  home_cc: IN

journal:
  unit: ssh

cowrie:
  home: /var/lib/shardlure/cowrie
  json_log: /var/lib/shardlure/cowrie/var/log/cowrie/cowrie.json
  # Cowrie systemd unit; read-only and used only for the dashboard uptime readout.
  # Set to "" to disable that readout; ShardLure never controls this unit.
  unit: cowrie

# Days to keep events, enrichment cache entries, artifacts, and TTY transcripts.
# Set to 0 to disable periodic purging (not recommended); the default is 90.
retention_days: 90

# Quarantine-fetch URLs from attacker commands; archive Cowrie downloads.
capture:
  enabled: true
  evidence_dir: /var/lib/shardlure/evidence
  quarantine_fetch: true
  max_bytes: 52428800
  timeout_sec: 45

geoip:
  # Required for globe arcs / country stats (resolves attacker IPs).
  # These two flags control the ip-api.com HTTP tier only.
  enabled: true
  insecure_http: true
  #
  # mmdb: path to a MaxMind GeoLite2/GeoIP2 City database. STRONGLY
  # recommended. It is tier 1 — tried before any HTTP lookup — and it:
  #   * resolves EVERY attacker IP, not just the ~48/poll the HTTP tier
  #     can afford (ip-api coverage is structurally partial)
  #   * sends nothing to a third party (the free ip-api tier is PLAIN HTTP,
  #     so every attacker IP you look up is visible on the wire)
  #   * works air-gapped / behind an egress filter
  # With mmdb set you can turn the flags above OFF for zero geo egress.
  # Get GeoLite2-City.mmdb free (account required) from MaxMind, or point
  # this at any GeoIP2 City database. Overridable with SHARDLURE_GEO_MMDB.
  # mmdb: /var/lib/shardlure/GeoLite2-City.mmdb

# Outbound threat-intel sharing. Each destination is opt-in; leaving
# api_key empty disables it. See the "Threat Intel Sharing" README
# section for the full submission policy and dry-run workflow.
intel:
  bazaar:
    # Sign up at https://auth.abuse.ch/ and paste your Auth-Key here.
    api_key: ""
    # Tags appended to every uploaded sample (in addition to the
    # per-sample auto-tags from the classifier).
    tags: ["shardlure", "honeypot"]
    # Hard client-side size cap. abuse.ch enforces its own server
    # cap; this is a safety rail against accidentally uploading a
    # cowrie SFTP capture that turns out to be a 4 GiB dump.
    max_bytes: 33554432   # 32 MiB
    # Abuse.ch fair-use: do not upload samples older than 10 days.
    # Valid values are 0..10 (0 uses the 10-day default). --since and
    # --sha only select local candidates; neither bypasses the Vet gate.
    freshness_days: 10
  urlhaus:
    # URLhaus receives the malware-distribution URLs the payloads came
    # from (bazaar receives the payload FILES). abuse.ch issues ONE
    # Auth-Key per account for both, so leaving this empty reuses
    # intel.bazaar.api_key above.
    api_key: ""
    # Tags attached to every submitted URL. URLhaus only permits
    # [A-Za-z0-9.- ]; anything else is stripped before submission.
    tags: ["shardlure", "honeypot"]
    # URLhaus only wants URLs that are still ACTIVELY serving a payload.
    # A URL is eligible only if our own fetch succeeded within this many
    # days. Valid values are 1..3 (0 uses the 3-day default); larger
    # values cannot loosen the gate.
    active_days: 3
    # Hide your abuse.ch handle on the public record. abuse.ch still
    # attributes the submission internally (anonymous submissions are
    # not accepted at all).
    anonymous: false
  abuseipdb:
    # Outbound REPORTING of confirmed brute-forcers to AbuseIPDB (the
    # give-back to the community feed). OFF by default. Enrichment /check
    # reads are unaffected by this and always work when the key is set.
    #
    # Reporting requires BOTH report_enabled: true AND the API key in the
    # SHARDLURE_ABUSEIPDB_KEY env var (reused from enrichment /check — the
    # key is never a config field). Never reports admin or private/reserved
    # IPs, and only reports actors that pass the vetting gate (confirmed
    # brute-force playbook + probe score + event/user floor).
    report_enabled: false
    # AbuseIPDB category IDs attached to every report. 18=Brute-Force, 22=SSH.
    # See https://www.abuseipdb.com/categories
    categories: [18, 22]
    # Minimum actor ProbeScore (0-100) to report. 60 = high-confidence only.
    min_probe_score: 60
    # Hours before a reported IP may be reported again. AbuseIPDB permits
    # re-reporting after 15 min; 24h keeps us well within fair use.
    rewindow_hours: 24
    # Optional operator suffix appended to the generated report comment. The
    # generated comment carries NOTHING identifying the honeypot host/session.
    comment: ""
